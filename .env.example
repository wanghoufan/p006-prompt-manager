# Prompt Manager 使用的共享 Supabase 项目（公开 URL，可提交）。
NEXT_PUBLIC_SUPABASE_URL=https://yacgnikzvutbpoqvokth.supabase.co

# 从 Supabase Dashboard → Settings → API Keys 复制 publishable key（sb_publishable_...）。
# 此项允许出现在浏览器；绝不能填写 sb_secret_...、service_role、数据库密码或 Access Token。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 部署后的站点 URL；登录回跳使用浏览器当前 origin，本变量供部署配置与文档使用。
# Mac Mini 局域网部署时填：http://Mac-mini.local:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100
