# 此文件是部署副本的环境变量模板：复制为 Services/prompt-manager/.env.local 后填写。
# 不要提交复制后的 .env.local，也不要把任何 Secret 写进 Dockerfile、compose.yaml 或 Git。

# ── AI 服务（通用格式；2026-09-10 收敛为 3 家：DeepSeek 官方 / OpenRouter / OpenCode）──
# 改这里即可切换厂商与模型；改完 docker compose restart 即生效（无需重建镜像）。
# 只有以下 4 个 provider 取值有效：deepseek / openrouter / opencode / opencode-go
# 示例① opencode Go 套餐（$10/月，实测可用：glm-5.3-flash、deepseek-v4-flash）：
#   AI_PROVIDER=opencode-go
#   AI_MODEL=deepseek-v4-flash        # 可用列表: https://opencode.ai/zen/go/v1/models
#   AI_BASE_URL=https://opencode.ai/zen/go/v1
#   AI_API_KEY=<opencode 控制台 opencode.ai/auth 获取>
# 示例② opencode Zen（免费版；按量计费模型需账户有余额，否则返回 Insufficient balance）：
#   AI_PROVIDER=opencode
#   AI_MODEL=glm-5.3-flash
#   AI_BASE_URL=https://opencode.ai/zen/v1
#   AI_API_KEY=<同上>
# 示例③ DeepSeek 官方：
#   AI_PROVIDER=deepseek
#   AI_MODEL=deepseek-v4-flash
#   AI_BASE_URL=https://api.deepseek.com
#   AI_API_KEY=<DeepSeek 平台密钥>
# 示例④ OpenRouter（模型名由用户自填，可用 openrouter/auto）：
#   AI_PROVIDER=openrouter
#   AI_MODEL=<任意 OpenRouter 模型名>
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=<OpenRouter 平台密钥>
AI_PROVIDER=<填入_厂商_如_opencode-go>
AI_MODEL=<填入_模型_ID>
AI_BASE_URL=<填入_接口地址>
AI_API_KEY=<填入_API_Key>

# 旧部署兼容（仅当 AI_* 未填时生效，可留空；也只在 provider=deepseek 时会被采用）：
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可公开的 Supabase 浏览器配置。publishable key 不是 service_role / secret key。
NEXT_PUBLIC_SUPABASE_URL=https://yacgnikzvutbpoqvokth.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<填入_Supabase_sb_publishable_key>

# Mac Mini 已核验的局域网主机名；它必须同时配置到 Supabase Redirect URLs。
NEXT_PUBLIC_APP_URL=http://Mac-mini.local:3100

# 旧 JSON/SSE 兼容链路的宿主机数据目录；先显式创建，compose 不会替你创建。
PROMPT_MANAGER_DATA_DIR=/Users/zzymima0000/DockerData/prompt-manager/legacy-store
PROMPT_MANAGER_PORT=3100
