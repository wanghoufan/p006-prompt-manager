# DeepSeek API 密钥（必填，从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：模型与接口地址（默认即为 deepseek-v4-flash / https://api.deepseek.com）
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Prompt Manager 使用的共享 Supabase 项目（公开 URL，可提交）。
NEXT_PUBLIC_SUPABASE_URL=https://yacgnikzvutbpoqvokth.supabase.co

# 从 Supabase Dashboard → Settings → API Keys 复制 publishable key（sb_publishable_...）。
# 此项允许出现在浏览器；绝不能填写 sb_secret_...、service_role、数据库密码或 Access Token。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 部署后的站点 URL；登录回跳使用浏览器当前 origin，本变量供部署配置与文档使用。
# Mac Mini 局域网部署时填：http://Mac-mini.local:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Docker 部署专用：旧 JSON/SSE 兼容数据在宿主机的持久化目录。
# 正式部署副本填：/Users/zzymima0000/DockerData/prompt-manager/legacy-store
# 本地开发不需要填写此项。
PROMPT_MANAGER_DATA_DIR=

# Docker 对外端口；通常保持 3100。
PROMPT_MANAGER_PORT=3100
