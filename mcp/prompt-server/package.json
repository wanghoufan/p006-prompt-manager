{
  "name": "prompt-manager-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Prompt Manager: 通过调取码从提示词管理库返回卡片内容",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prompt-manager-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "setup": "node setup.mjs",
    "setup:check": "node setup.mjs --check",
    "setup:remove": "node setup.mjs --remove"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
